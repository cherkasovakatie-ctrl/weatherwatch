  "scenes": [
   {
    "t": "2026-10-14T00:00Z",
    "title": "14 October: the ingredients are in place",
    "text": "A cluster of thunderstorms drifts west in the trade winds about 1,800 km east of Guam. Every ingredient a tropical cyclone needs is already there: the sea is about 29 °C, 2–3 °C above the 26.5 °C threshold; the warm layer runs deep, so stirring the ocean will not cool it; and the air is moist. The only thing missing is calm winds aloft — shear of 15–20 kt is still tilting the storms and stopping them from organising around one centre."
   },
   {
    "t": "2026-10-14T18:00Z",
    "title": "Late on 14 October: conditions become right for a depression",
    "text": "Shear eases just enough for the thunderstorms to stack up over one spot. Pressure starts to fall and the surface winds wrap all the way around the centre: Tropical Depression 29W forms (early on 15 October, Guam time) over 29–29.6 °C water. From now on the storm feeds itself — warm, moist air spirals in, rises, releases heat and lowers the pressure further."
   },
   {
    "t": "2026-10-15T15:00Z",
    "title": "Champi is named",
    "text": "Sustained winds reach 35 kt (40 mph): Tropical Storm Champi, about 800 miles east of Guam, moving west at 12 mph. Guam goes to Condition of Readiness 3 and a Typhoon Watch is issued for Guam, Rota, Tinian and Saipan."
   },
   {
    "t": "2026-10-16T06:00Z",
    "title": "The brakes come off",
    "text": "Shear eases and a strong outflow channel opens to the west, letting the storm vent its rising air at the top. An inner core forms. From here Champi strengthens fast: +40 kt in 23 hours, well past the 30-kt-in-24-hours mark for rapid intensification."
   },
   {
    "t": "2026-10-16T21:00Z",
    "title": "A typhoon",
    "text": "85 mph winds, 340 miles east-southeast of Guam, moving west-northwest at 15 mph, steered by the subtropical high to the north. A Typhoon Warning is issued for Guam and Rota; the ports go to Condition ZULU."
   },
   {
    "t": "2026-10-17T00:00Z",
    "title": "Now — the rest is forecast",
    "text": "This is the latest observed position. From here the track (dashed) is the Joint Typhoon Warning Center forecast. Ahead lies even deeper warm water: ocean heat content of 120–150 kJ/cm², roughly 150 m of water warmer than 26 °C."
   },
   {
    "t": "2026-10-17T21:00Z",
    "title": "Closest approach to Guam (forecast)",
    "text": "Around 7 am Sunday local time, just south of or over southern Guam as a Category 3 typhoon: winds 105–120 mph with gusts to 155 mph, 12–20 inches of rain, surf up to 35 ft and 5–7 ft of coastal inundation."
   },
   {
    "t": "2026-10-18T18:00Z",
    "title": "Super typhoon (forecast)",
    "text": "Over the open Philippine Sea, shear drops below 10 kt and the warm layer is deep enough that the storm cannot cool the water beneath it. JTWC forecasts 135 kt — a super typhoon — and one model shows 160 kt."
   },
   {
    "t": "2026-10-21T18:00Z",
    "title": "Where next? (forecast)",
    "text": "Still about 120 kt near 20°N 128°E, rounding the western edge of the subtropical high toward the waters east of Taiwan and south of the Ryukyus. Whether it recurves north depends on a trough over East Asia. This part of the forecast is the least certain."
   }
  ]
